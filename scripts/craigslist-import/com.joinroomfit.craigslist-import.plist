<?xml version="1.0" encoding="UTF-8"?>
<!-- Runs the Craigslist import every day at 9:00 (the Mac's local time, so the
     Mac must be on Pacific time). launchd, not cron: if the Mac is asleep at
     9:00, launchd runs it as soon as it wakes. Install steps: README.md.
     Replace REPO with the full path to your roomfit checkout. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.joinroomfit.craigslist-import</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/node</string>
    <string>REPO/scripts/craigslist-import/import.mjs</string>
  </array>

  <key>WorkingDirectory</key>
  <string>REPO/scripts/craigslist-import</string>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>9</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>REPO/scripts/craigslist-import/import.log</string>
  <key>StandardErrorPath</key>
  <string>REPO/scripts/craigslist-import/import.log</string>
</dict>
</plist>
