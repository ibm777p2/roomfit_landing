# Copy to .env (gitignored) and fill in. Never commit the real file.

# The RoomFit Supabase project, and its publishable key (sb_publishable_…).
# Never the service_role key: the script signs in as an admin instead.
SUPABASE_URL=https://nmmbktcqjznwdddwqxad.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# A RoomFit account used only for imports. Sign it up in the app, then set
# profiles.role = 'admin' for it in the dashboard. Imported rooms are owned by
# it until their hosts claim them.
IMPORT_EMAIL=
IMPORT_PASSWORD=

# Apify → Settings → API & Integrations → Personal API token.
APIFY_TOKEN=

# Optional limits (defaults shown).
# MAX_ITEMS=150        posts scraped per run (~$0.0015 each)
# MAX_CHARGE_USD=1     Apify stops the run if it would cost more than this
# LOOKBACK_HOURS=504   skip posts older than this (3 weeks)
