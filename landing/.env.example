# Copy to .env.local for local development. Never commit .env.local.
# In Vercel these live under Settings → Environment Variables.

# Supabase: the same project as the app. Server-side only (no NEXT_PUBLIC_),
# used by the waitlist server action. The publishable key is public by design;
# the waitlist table itself is closed, and sign-ups go through join_waitlist().
# Never put the service_role key here.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Where "Try the demo" goes.
NEXT_PUBLIC_APP_URL=https://app.joinroomfit.com

# This site's own address, for link previews and the sitemap.
NEXT_PUBLIC_SITE_URL=https://joinroomfit.com
